{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "720px", "wideSize": "1180px" },
		"color": {
			"palette": [
				{ "slug": "ink", "name": "Ink", "color": "#0f1115" },
				{ "slug": "ink-soft", "name": "Body text", "color": "#3f4652" },
				{ "slug": "accent", "name": "Accent", "color": "#6d28d9" },
				{ "slug": "accent-dark", "name": "Accent dark", "color": "#5b21b6" },
				{ "slug": "accent-tint", "name": "Accent tint", "color": "#f3effe" },
				{ "slug": "surface", "name": "Surface", "color": "#ffffff" },
				{ "slug": "surface-soft", "name": "Surface soft", "color": "#f6f7f9" },
				{ "slug": "dark", "name": "Dark", "color": "#0f1115" },
				{ "slug": "line", "name": "Border", "color": "#e5e7eb" }
			]
		},
		"typography": {
			"fluid": false,
			"fontSizes": [
				{ "slug": "sp-small", "name": "Small", "size": "0.875rem" },
				{ "slug": "sp-body", "name": "Body", "size": "1.0625rem" },
				{ "slug": "sp-lead", "name": "Lead", "size": "clamp(1.125rem, 1.05rem + 0.4vw, 1.3rem)" },
				{ "slug": "sp-h3", "name": "Heading 3", "size": "clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem)" },
				{ "slug": "sp-h2", "name": "Heading 2", "size": "clamp(1.75rem, 1.2rem + 2vw, 2.75rem)" },
				{ "slug": "sp-h1", "name": "Heading 1", "size": "clamp(2.5rem, 1.5rem + 4vw, 4.5rem)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--surface)",
			"text": "var(--wp--preset--color--ink-soft)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--manrope, system-ui, -apple-system, 'Segoe UI', sans-serif)",
			"fontSize": "var(--wp--preset--font-size--sp-body)",
			"fontWeight": "400",
			"lineHeight": "1.7"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent-dark)" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": { "fontWeight": "700", "lineHeight": "1.15", "letterSpacing": "-0.02em" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--sp-h1)", "lineHeight": "1.05", "letterSpacing": "-0.03em" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--sp-h2)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--sp-h3)", "fontWeight": "600" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--ink)", "text": "var(--wp--preset--color--surface)" },
				"border": { "radius": "999px" },
				"typography": { "fontSize": "1rem", "fontWeight": "600" },
				"spacing": { "padding": { "top": "0.85em", "bottom": "0.85em", "left": "1.6em", "right": "1.6em" } },
				":hover": { "color": { "background": "var(--wp--preset--color--accent)", "text": "var(--wp--preset--color--surface)" } },
				":focus": { "color": { "background": "var(--wp--preset--color--accent)", "text": "var(--wp--preset--color--surface)" } }
			}
		}
	}
}

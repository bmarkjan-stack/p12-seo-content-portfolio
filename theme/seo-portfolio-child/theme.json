{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"customTemplates": [
    	{ "name": "page-about", "title": "About", "postTypes": [ "page" ] },
    	{ "name": "page-services", "title": "Services", "postTypes": [ "page" ] },
	   	{ "name": "page-contact", "title": "Contact", "postTypes": [ "page" ] }
	],
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1180px"
		},
		"color": {
			"defaultPalette": false,
			"palette": [
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#0f1115"	
				},
				{
					"slug": "ink-soft",
					"name": "Body Text",
					"color": "#3f4652"
				},
				{
					"slug": "accent",
					"name": "Violet Accent",
					"color": "#6d28d9"
				},
				{
					"slug": "accent-dark",
					"name": "Accent Hover",
					"color": "#5b21b6"
				},
				{
					"slug": "accent-tint",
					"name": "Soft Violet",
					"color": "#f3effe"
				},
				{
					"slug": "surface",
					"name": "White",
					"color": "#ffffff"
				},
				{
					"slug": "surface-soft",
					"name": "Soft Surface",
					"color": "#f6f7f9"
				},
				{
					"slug": "dark",
					"name": "Dark Surface",
					"color": "#0f1115"
				},
				{
					"slug": "line",
					"name": "Border",
					"color": "#e5e7eb"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "manrope",
					"name": "Manrope",
					"fontFamily": "Manrope, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "sp-small",
					"name": "Small",
					"size": "0.875rem"
				},
				{
					"slug": "sp-body",
					"name": "Body",
					"size": "1.0625rem"
				},
				{
					"slug": "sp-lead",
					"name": "Lead",
					"size": "clamp(1.125rem, 1.05rem + 0.4vw, 1.3rem)"
				},
				{
					"slug": "sp-h3",
					"name": "Heading 3",
					"size": "clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem)"
				},
				{
					"slug": "sp-h2",
					"name": "Heading 2",
					"size": "clamp(1.75rem, 2.5vw + 1rem, 2.5rem)"
				},
				{
					"slug": "sp-h1",
					"name": "Heading 1",
					"size": "clamp(2.5rem, 5vw + 1rem, 4.5rem)"
				}
			]
		},
		"spacing": {
			"units": ["px", "rem", "em", "%", "vw"]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--surface)",
			"text": "var(--wp--preset--color--ink-soft)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--manrope)",
			"fontSize": "var(--wp--preset--font-size--sp-body)",
			"fontWeight": "400",
			"lineHeight": "1.75"
		},
		"spacing": {
			"blockGap": "1.5rem"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.15",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--sp-h1)",
					"lineHeight": "1.05",
					"letterSpacing": "-0.035em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--sp-h2)",
					"lineHeight": "1.15"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--sp-h3)",
					"fontWeight": "600",
					"lineHeight": "1.25"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent-dark)"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--accent-dark)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--ink)",
					"text": "var(--wp--preset--color--surface)"
				},
				"border": {
					"radius": "999px"
				},
				"typography": {
					"fontSize": "1rem",
					"fontWeight": "600"
				},
				"spacing": {
					"padding": {
						"top": "0.85em",
						"bottom": "0.85em",
						"left": "1.6em",
						"right": "1.6em"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--surface)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--surface)"
					}
				}
			}
		}
	}
}